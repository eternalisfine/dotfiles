{
  "layer": "top",
  "position": "top",
  "margin-top": 0,
  "width": 1920,
    
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["bluetooth","mpris","custom/warp","custom/tailscale","pulseaudio", "tray", "network", "battery"],

  "tray": {
      "spacing": 10,
      "icon-size": 18,
      "show-passive-items": true
    },
  
  "mpris": {
    "interval": 1,
    "format": "{status_icon} {title} - {artist}",
    "format-stopped": "{status-icon}",
    "artist-len": 15,
    "title-len": 15,
    "player-icons": {
		  "firefox": "",
	  	"chromium": ""
		},
    "status-icons": {
			"playing": "",
			"paused": "",
			"stopped": ""
		},
  },

  "bluetooth": {
      "interval": 5,
  	    "return-type": "json",
	    "exec": "/home/deepyaman/.config/waybar/scripts/bluetooth_status.sh",
	    "on-click": "/home/deepyaman//.config/waybar/scripts/bluetooth_toggle.sh",
      "tooltip": true
    },

  "battery": {
    "format": "{capacity}% {icon}",
    "format-icons": {
        "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
    }
  },

  "clock": {
    "format-alt": "{:%a, %d %b - %H:%M}",
    "on-click": "gsimplecal",
    "tooltip": false
  },

  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}% 󰂯 ",
    "format-muted": " Muted",
    "format-icons": {
      "alsa_output.pci-0000_00_1f.3.analog-stereo": " ",
      "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "  ",
      "headphone": " ",
      "hands-free": " ",
      "headset": " ",
      "default": [" ", " "]
    },
	  "scroll-step": 1,
    "on-click": "pavucontrol",
    "ignored-sinks": ["Easy Effects Sink"]
  },

  "network": {
    "interface": "wlan0",
    "format": "{ifname}",
    "format-wifi": "{essid}  ",
  	"format-ethernet": "{ipaddr}/{cidr} 󰊗 ",
	  "format-disconnected": "󰖪", //An empty format will hide the module.
    "tooltip-format": "{ifname} via {gwaddr} 󰊗 ",
    "tooltip-format-wifi": "{essid}({signalStrength}%)  ",
    "tooltip-format-ethernet": "{ifname}  ",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50
  },

  "hyprland/workspaces": {
	  "format": "{name}: {icon}",
	  "format-icons": {
		  "1": "",
		  "2": "",
		  "3": "",
		  "4": "",
		  "5": "",
		  "active": "",
		  "default": ""
	  },

    "persistent-workspaces": {
              "*": 5, // 5 workspaces by default on every monitor
              "HDMI-A-1": 3 // but only three on HDMI-A-1
    }
  },

  "custom/warp": {
	  "format": "{}",
	  "return-type": "json",
	  "interval": 1,
	  "exec": "~/.config/waybar/scripts/warp.sh",
	  "on-click": "warp-cli connect",
	  "on-click-right": "warp-cli disconnect"
  },

  "custom/tailscale": {
    "format": "{}",
    "return-type": "json",
    "interval": 1,
    "exec": "/home/deepyaman/.config/waybar/scripts/tailscale-status.sh",
    "on-click": "/home/deepyaman/.config/waybar/scripts/tailscale-connect.sh",
    "on-click-right": "/home/deepyaman/.config/waybar/scripts/tailscale-disconnect.sh",
    "tooltip": true
  }
}
    "format": "{}",
